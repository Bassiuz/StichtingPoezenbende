rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only users with a doc at admin/{uid} may write; sign-up alone grants nothing.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isValidKat(d) {
      return d.keys().hasOnly(['naam', 'tekst', 'foto', 'aangemaakt', 'extraFotos', 'verborgen'])
        && d.naam is string && d.naam.size() > 0 && d.naam.size() <= 60
        && d.tekst is string && d.tekst.size() <= 1000
        && d.foto is string && d.foto.matches('^data:image/(webp|jpeg);base64,.*')
        && d.foto.size() <= 400000
        && d.aangemaakt is timestamp
        && (!('extraFotos' in d) || (d.extraFotos is int && d.extraFotos >= 0 && d.extraFotos <= 5))
        && (!('verborgen' in d) || d.verborgen is bool);
    }

    match /katten/{id} {
      // Hidden cats are only readable by admins, so visitors must query verborgen == false.
      allow read: if isAdmin() || resource.data.verborgen == false;
      allow create, update: if isAdmin() && isValidKat(request.resource.data);
      allow delete: if isAdmin();
    }

    // Extra photos per cat, read only when a visitor opens that cat.
    match /fotos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['fotos'])
        && request.resource.data.fotos is list
        && request.resource.data.fotos.size() <= 5;
      allow delete: if isAdmin();
    }

    match /meta/versie {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['v'])
        && request.resource.data.v == request.time;
    }
  }
}
